{
  "name": "clipboard-manager",
  "version": "1.2.2",
  "description": "Fast clipboard history manager for Linux",
  "main": "./out/main/index.js",
  "author": {
    "name": "Suraj Kolhe",
    "email": "surajkolhe214@gmail.com"
  },
  "license": "MIT",
  "homepage": "https://github.com/kolhesuraj/clipboard-manager-website",
  "scripts": {
    "dev": "ELECTRON_EXEC_PATH=scripts/electron electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite build && ELECTRON_EXEC_PATH=scripts/electron electron-vite preview",
    "start": "ELECTRON_EXEC_PATH=scripts/electron electron-vite preview",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "dist": "electron-vite build && electron-builder --linux",
    "postinstall": "electron-rebuild -f -w better-sqlite3 && node create-icon.js",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@eslint/js": "^9.5.0",
    "@types/better-sqlite3": "^7.6.8",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9",
    "electron-vite": "^2.3.0",
    "eslint": "^9.5.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.34.3",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.7",
    "prettier": "^3.3.3",
    "typescript": "^5.5.2",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.3.1"
  },
  "dependencies": {
    "better-sqlite3": "^11.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "build": {
    "appId": "com.clipboardmanager.app",
    "productName": "clipboard-manager",
    "executableName": "clipboard-manager",
    "icon": "resources/icon-512.png",
    "electronLanguages": ["en-US"],
    "afterPack": "build/afterPack.js",
    "files": [
      "out/**/*",
      "!node_modules/better-sqlite3/deps/**",
      "!node_modules/better-sqlite3/src/**",
      "!node_modules/better-sqlite3/build/Release/obj.target/**",
      "!node_modules/prebuild-install/**",
      "!node_modules/node-abi/**",
      "!node_modules/napi-build-utils/**",
      "!node_modules/tar-stream/**",
      "!node_modules/tar-fs/**",
      "!node_modules/readable-stream/**",
      "!node_modules/buffer/**",
      "!node_modules/detect-libc/**",
      "!node_modules/rc/**",
      "!node_modules/simple-get/**",
      "!node_modules/simple-concat/**",
      "!node_modules/tunnel-agent/**",
      "!node_modules/decompress-response/**",
      "!node_modules/bl/**",
      "!node_modules/pump/**",
      "!node_modules/mkdirp-classic/**",
      "!node_modules/end-of-stream/**",
      "!node_modules/github-from-package/**",
      "!node_modules/expand-template/**",
      "!node_modules/deep-extend/**",
      "!node_modules/minimist/**",
      "!node_modules/strip-json-comments/**",
      "!node_modules/ini/**",
      "!node_modules/fs-constants/**",
      "!node_modules/once/**",
      "!node_modules/wrappy/**",
      "!node_modules/safe-buffer/**",
      "!node_modules/ieee754/**",
      "!node_modules/base64-js/**",
      "!node_modules/inherits/**",
      "!node_modules/string_decoder/**",
      "!node_modules/util-deprecate/**"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "."
      }
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon-512.png",
      "category": "Utility",
      "description": "Fast clipboard history manager for Linux",
      "synopsis": "Clipboard history manager",
      "desktop": {
        "Name": "Clipboard Manager",
        "Comment": "Fast clipboard history manager for Linux",
        "StartupNotify": "false",
        "Terminal": "false"
      }
    },
    "deb": {
      "afterInstall": "build/afterInstall.sh",
      "afterRemove": "build/afterRemove.sh",
      "depends": [
        "libnotify4",
        "libxtst6",
        "libnss3",
        "libsecret-1-0",
        "wtype",
        "xdotool",
        "ydotool"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "kolhesuraj",
      "repo": "clipboard-manager-app"
    }
  }
}
